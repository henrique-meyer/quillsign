@page "/draft/{publicId}/sent"
@model QuillSign.Pages.Draft.SentModel
@{ ViewData["Title"]="Request status"; }
@section Styles { <link rel="stylesheet" href="~/review.css" asp-append-version="true" /> }
<section class="draft-review">
<p class="eyebrow">Private request status</p><h1>@(Model.Data?.Title ?? "Check your request")</h1>
@if(Model.ErrorMessage is not null) { <p class="document-error" role="alert">@Model.ErrorMessage</p> }
@if(Model.Notice is not null) { <p class="notice" role="status">@Model.Notice</p> }
@if(Model.Data is { } data) {
<h2>@data.State</h2><p>Sent at @data.SentAt.ToString("u"). The sent document and preparation are frozen.</p>
@if(Model.Void?.Action is { } action) {
<section aria-labelledby="void-heading"><h2 id="void-heading">Recorded void</h2><p>Voided at @action.VoidedAt.ToString("u") (UTC). Further signing has stopped. Earlier signing actions remain in the retained history.</p>
@if(action.Reason is { } reason) {<h3>Sender's reason</h3><p class="document-message">@reason</p>}
<p>Email delivery is not confirmed by this record.</p></section>
}
@if(Model.Void?.CanVoid==true) {<p><a asp-page="/Draft/Void" asp-route-publicId="@data.PublicId">Review void action</a></p>}
@if(Model.Resend is {Blocked:null}) {<p><a asp-page="/Draft/Resend" asp-route-publicId="@data.PublicId">Review replacement invitation</a></p>}
else if(Model.Resend?.Blocked is { } blocked) {<p>@QuillSign.Pages.Draft.ResendModel.Message(blocked)</p>}
@if(Model.Correction is {Blocked:null}) {<p><a asp-page="/Draft/CorrectContact" asp-route-publicId="@data.PublicId">Review current signer's email correction</a></p>}
else if(Model.Correction?.Blocked is { } correctionBlocked) {<p>@QuillSign.Pages.Draft.CorrectContactModel.Message(correctionBlocked)</p>}
@if(Model.Final is { } final) {
<section aria-labelledby="final-heading"><h2 id="final-heading">Final packet</h2>
<p>Completed at @final.CompletedAt.ToString("u"). Save both files for your records. These downloads verify the saved packet before serving it.</p>
<form method="post" asp-page-handler="Download"><input type="hidden" name="kind" value="executed" /><button type="submit">Download executed PDF</button></form>
<form method="post" asp-page-handler="Download"><input type="hidden" name="kind" value="certificate" /><button type="submit">Download certificate of completion</button></form>
@if(final.RetainedUntil is { } until) { <p>Server retention ends at @until.ToString("u"). Save your copies before then.</p> }
<p>Downloads use your current verified session. Preparing a download does not confirm receipt or saving. Completion email delivery is not confirmed by this page.</p></section>
}
else if(data.Status==QuillSign.Data.EnvelopeStatus.Completed) { <p class="notice" role="status">Final downloads are unavailable in this session. Refresh manually to retry.</p> }
<p>Submission to an email provider does not confirm inbox delivery. Check each signer's latest invitation status below.</p>
@if(data.ExpiresAt is { } expires) { <p>Request expiry: @expires.ToString("u").</p> }
@if(!string.IsNullOrEmpty(data.Message)) { <p class="document-message">@data.Message</p> }
<h2>Sequential signing progress</h2>
<ol class="signer-cards">@foreach(var signer in data.Signers) {
<li class="signer-card" value="@signer.Order"><strong>@signer.Name</strong><span class="signer-email">@signer.Email</span>
@if(!string.IsNullOrEmpty(signer.Role)) { <p>@signer.Role</p> }<p>@signer.State</p>
@if(signer.Invitation is {Kind:"Replacement"} invitation) {
@if(invitation.State!=signer.State) {<p>Latest invitation: @invitation.State</p>}
<p>Replacement requested at @invitation.RequestedAt?.ToString("u") (UTC). Older unused links were invalidated; already-opened sessions keep their original expiry.</p>
}
@if(signer.SignedAt is { } signed) { <p>Signed at @signed.ToString("u").</p> }
</li> }</ol>
<h2>Completion recipients</h2><p>The sender and signers are included in the completed packet distribution.</p>
@if(data.Recipients.Count==0) { <p>No additional completion recipients.</p> }
<ul class="recipient-cards">@foreach(var recipient in data.Recipients) { <li class="signer-card"><strong>@recipient.Name</strong><span class="signer-email">@recipient.Email</span></li> }</ul>
<p>This private page uses your verified sender session. Keep this tab to check progress during that session.</p>
}
<p><a asp-page="/Draft/Sent" asp-route-publicId="@RouteData.Values["publicId"]">Refresh status</a></p>
</section>
