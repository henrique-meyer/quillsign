@page "/draft/{publicId}/review"
@model QuillSign.Pages.Draft.ReviewModel
@using QuillSign.Sender
@{ ViewData["Title"] = "Review document preparation"; }
<div class="draft-review">
<p class="eyebrow">ONE LAST LOOK</p>
<h1>Review your draft.</h1>
@if(Model.ErrorMessage is not null) { <p class="document-error" role="alert">@Model.ErrorMessage</p><p><a href="">Reload and review saved state</a></p> }
@if(Model.Notice is not null) { <p class="notice" role="status">@Model.Notice</p> }
@if(Model.Draft is not null) {
<p class="intro">Check the document, signing order, and everyone who receives the completed packet.</p>
<section class="notice" aria-labelledby="checks-title">
    <h2 id="checks-title">@(Model.Draft.ChecksPassed ? "Preparation checks passed" : "Preparation needs attention")</h2>
    @if (Model.Draft.Errors.Count > 0)
    {
        <ul>@foreach (var issue in Model.Draft.Errors) { <li><a href="@Model.StepUrl(issue.Step)">@issue.Message</a></li> }</ul>
    }
    else { <p>The PDF is confirmed, signers are set up, fields are within page bounds, and sender values are filled.</p> }
    @if (Model.Draft.Warnings.Count > 0)
    {
        <h3>Review these warnings</h3>
        <ul>@foreach (var issue in Model.Draft.Warnings) { <li><a href="@Model.StepUrl(issue.Step)">@issue.Message</a></li> }</ul>
        <p class="hint">Warnings do not block preparation.</p>
    }
</section>
<section class="start-card" aria-labelledby="document-title">
    <h2 id="document-title">Document</h2><p><strong>@(Model.Draft.Title ?? "Untitled document")</strong></p>
    @if (!string.IsNullOrEmpty(Model.Draft.Message)) { <p class="document-message">@Model.Draft.Message</p> }
    <p>@(Model.Draft.HasPdf ? $"{Model.Draft.PageCount} PDF page(s)" : "No PDF uploaded") · @(Model.Draft.PreviewConfirmed ? "Preview confirmed" : "Preview not confirmed")</p>
    <p><a href="@Model.StepUrl("")">Review PDF preview</a> · <a href="@Model.StepUrl("details")">Edit title and message</a></p>
</section>
<section class="signer-list" aria-labelledby="signers-title">
    <h2 id="signers-title">Sequential signing order</h2>
    @if (Model.Draft.Signers.Count == 0) { <p>No signers added.</p> }
    <ol class="signer-cards">@foreach (var signer in Model.Draft.Signers)
    {
        <li class="signer-card" value="@signer.Order"><strong>@signer.FullName</strong><span class="signer-email">@signer.Email</span>
            @if (!string.IsNullOrEmpty(signer.Role)) { <p>@signer.Role</p> }
            <p>@Model.Draft.Fields.Count(f => f.SignerId == signer.Id) assigned field(s)</p>
        </li>
    }</ol>
    <p><a href="@Model.StepUrl("signers")">Edit signers and order</a> · <a href="@Model.StepUrl("fields")">Edit document fields</a></p>
</section>
<section class="signer-list" aria-labelledby="sender-fields-title">
    <h2 id="sender-fields-title">Sender-filled fields</h2>
    <p>These values become fixed content before signing begins.</p>
    @if (!Model.Draft.Fields.Any(f => f.SignerId is null)) { <p>No sender-filled fields.</p> }
    <ul class="recipient-cards">@foreach (var field in Model.Draft.Fields.Where(f => f.SignerId is null))
    {
        <li class="signer-card"><strong>@(field.Label ?? field.Type) · Page @field.Page</strong>
            <p class="document-message">@(field.Type == "Checkbox" && field.Value is "true" or "false" ? (field.Value == "true" ? "Checked" : "Unchecked") : string.IsNullOrWhiteSpace(field.Value) ? "Not filled" : field.Value)</p>
        </li>
    }</ul>
    <p><a href="@Model.StepUrl("fields")">Edit sender values</a></p>
</section>
<section class="signer-list" aria-labelledby="recipients-title">
    <h2 id="recipients-title">Completion recipients (CC)</h2>
    <p>The sender and all signers receive the completed packet. These additional recipients receive it without signing.</p>
    @if (Model.Draft.Recipients.Count == 0) { <p>No additional completion recipients.</p> }
    <ul class="recipient-cards">@foreach (var recipient in Model.Draft.Recipients)
    { <li class="signer-card"><strong>@recipient.Name</strong><span class="signer-email">@recipient.Email</span></li> }</ul>
    <p><a href="@Model.StepUrl("details")">Edit completion recipients</a></p>
</section>
<p class="hint">Your document stays a draft. Reviewing it sends no invitations.</p>
<section class="start-card">
<h2>Send for signing</h2>
@if(Model.Draft.ExpiresAt is { } expiry) { <p>Request expiry: @expiry.ToString("u").</p> }
@if(Model.Draft.RetentionDeleteAfter is { } cutoff) { <p class="hint">This demo document's fixed retention ends @cutoff.ToString("u"). The signing deadline cannot be later.</p> }
@if(Model.Readiness?.Reminders is { } reminders) {
<h3>Automatic reminders</h3>
@if(reminders.Days.IsEmpty) { <p>No automatic reminders are scheduled for this request.</p> }
else { <p>The reviewed reminder policy allows reminders @string.Join(" and ",reminders.Days) day(s) after each current signer's original invitation, while signing remains incomplete and before expiry or retention ends.</p>
<p class="hint">These reminders replace unused invitation links while preserving opened signing sessions. They stop when the signer finishes, the contact changes, or the request closes. Delayed reminders are combined, and delivery limits can prevent a reminder.</p> }
}
@if(Model.Readiness?.Error is { } error) { <p class="document-error" role="status">@error</p> }
@if(Model.Readiness?.Disclosure is { } disclosure) { <h3>Electronic-record disclosure for this request</h3><pre class="send-disclosure" tabindex="0" aria-label="Electronic-record disclosure for this request">@disclosure.Text</pre> }
<p>Sending freezes this preparation and queues the first signing invitation. Later signers are invited in order after each signing copy is processed.</p>
<form method="post" asp-page-handler="Send">
<input type="hidden" asp-for="Version" /><input type="hidden" name="StatementVersion" value="@SenderSendStatement.Version" />
@if(Model.Readiness?.Reminders is not null) { <input type="hidden" asp-for="ReminderSha256" /><input type="hidden" asp-for="ReminderSchedulingVersion" /> }
@if(Model.Draft.RetentionSha256 is not null) { <input type="hidden" asp-for="RetentionSha256" /> }
@if(Model.Draft.ProductionDisclosure is not null) { <input type="hidden" asp-for="DisclosureSha256" /> }
<label class="send-check"><input type="checkbox" asp-for="ExclusionsAcknowledged" required /> I confirm this is not a will, court or family-law document, foreclosure/eviction/utility notice, or another excluded record, and this transaction is suitable for electronic signing.</label>
<label class="send-check"><input type="checkbox" asp-for="SendAcknowledged" required /> @SenderSendStatement.Text</label>
<button type="submit" disabled="@(!Model.Draft.ChecksPassed || Model.Readiness?.Available!=true || Model.ReloadRequired)">Send for signing</button>
</form>
</section>
}
</div>
@section Styles { <link rel="stylesheet" href="~/review.css" asp-append-version="true" /> }
