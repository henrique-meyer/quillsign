@page "/operator/retention/{handler?}"
@model QuillSign.Pages.Operator.RetentionModel
@{ Layout=null; }
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Private record controls — QuillSign</title><link rel="stylesheet" href="~/css/operator.css"/></head>
<body><main><h1>Private record controls</h1><p>Exact records only. Recorded preservation receipts and current provider inspection are separate observations. A pending or uncertain outcome keeps the record blocked.</p>
@if(Model.Notice is not null){<p role="status">@Model.Notice</p>}
@if(!Model.SignedIn){<form method="post" asp-page-handler="SignIn"><button type="submit">Sign in with configured identity provider</button></form>}
else{
<form method="post" asp-page-handler="SignOut"><button type="submit">Sign out</button></form>
<section aria-labelledby="select"><h2 id="select">Inspect an exact record</h2><form method="post" asp-page-handler="Status"><label for="record">Record identifier (32 hexadecimal characters)</label><input id="record" name="RecordId" value="@Model.RecordId" maxlength="32" required autocomplete="off"/><button type="submit">Read status</button><button type="submit" asp-page-handler="Inspect">Inspect active provider protection</button></form></section>
@if(Model.Current is {} current){<section aria-labelledby="status"><h2 id="status">Recorded status</h2><dl><dt>Record</dt><dd>@current.RecordId</dd><dt>Stage</dt><dd>@current.Stage</dd><dt>Policy</dt><dd>@current.PolicyVersion</dd><dt>Ordinary deadline</dt><dd>@current.Deadline</dd><dt>Request revision</dt><dd>@current.Revision</dd><dt>Record gate</dt><dd>@(current.Frozen?"Blocked":"No active hold gate")</dd><dt>Archive receipts</dt><dd>@current.ArchivedObjects</dd><dt>Current provider observation</dt><dd>@(current.FreshProtection?"Explicit inspection completed":"Not inspected by this request")</dd></dl><ul>@foreach(var h in current.Holds){<li><code>@h.HoldId</code>: @h.State</li>}</ul></section>}
<section aria-labelledby="hold"><h2 id="hold">Review one hold command</h2><p>Placement blocks later business changes immediately. Each independent hold requires its own exact release. Review the recorded state before continuing an unresolved operation.</p>
<form method="post" asp-page-handler="Review"><input type="hidden" name="RecordId" value="@Model.RecordId"/><label for="operation">Command</label><select id="operation" name="Operation"><option value="Place">Place a new independent hold</option><option value="Release">Release one exact preserved hold</option></select><label for="holdid">Existing hold identifier (release only)</label><input id="holdid" name="HoldId" maxlength="32" autocomplete="off"/><label for="purpose">Authorized purpose</label><input id="purpose" name="Purpose" maxlength="256" required autocomplete="off"/><label for="reason">Private reason</label><textarea id="reason" name="Reason" maxlength="2048" required></textarea><label for="reference">Private reference</label><input id="reference" name="Reference" maxlength="512" required autocomplete="off"/><button type="submit">Review exact command</button></form></section>
@if(Model.Review is {} review){<section aria-labelledby="confirm"><h2 id="confirm">Confirm @review.Operation</h2><p>Hold <code>@review.HoldId</code>. Purpose: @review.Purpose. This confirmation expires within two minutes and is bound to this session and the reviewed state.</p><form method="post" asp-page-handler="Confirm"><input type="hidden" name="Confirmation" value="@review.Confirmation"/><button type="submit">Confirm this exact command</button></form></section>}
<section aria-labelledby="export"><h2 id="export">Private evidence inventory</h2><p>Requires separate sensitive-read permission. The export includes private hold reasons and references, inventory hashes and historical receipts. It grants no participant, provider or deletion capability.</p><form method="post" asp-page-handler="Export"><input type="hidden" name="RecordId" value="@Model.RecordId"/><label for="exportpurpose">Authorized export purpose</label><input id="exportpurpose" name="Purpose" maxlength="256" required autocomplete="off"/><button type="submit">Export private inventory</button></form></section>
}
</main></body></html>
