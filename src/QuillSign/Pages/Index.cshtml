@page
@model QuillSign.Pages.IndexModel
        <p class="eyebrow">OPEN SOURCE · E-SIGNATURES</p>
        <h1>A simpler way<br />to sign together.</h1>
        <p class="intro">No accounts. No subscriptions. Documents signed in order, with a copy for everyone.</p>
        @if (Model.Notice is not null) { <p class="notice" role="status">@Model.Notice</p> }
        <section class="start-card" aria-labelledby="start-title">
            <h2 id="start-title">Start with your email</h2>
            <p>We'll send a single-use link to verify your address and open your draft.</p>
            @if (Model.CanSend)
            {
                <form method="post" asp-page="/Index">
                    <label asp-for="Email">Email address</label>
                    <input asp-for="Email" type="email" autocomplete="email" inputmode="email" placeholder="you@example.com" required maxlength="320" />
                    <span asp-validation-for="Email" class="validation" role="alert"></span>
                    <button type="submit">Send verification link</button>
                </form>
                <p class="hint">No password. Your link is valid for 15 minutes after it's sent.</p>
            }
            else
            {
                <p class="notice">Email delivery is currently unavailable. Please check back soon.</p>
            }
        </section>
        <p><a asp-page="/Verify">Verify a completed PDF</a></p>
