@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{ var preview = QuillSign.Sharing.PublicPreview.For(Context, Configuration); }
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(preview?.Title ?? (ViewData["Title"] is { } title ? $"{title} · QuillSign" : "QuillSign"))</title>
    @if (preview is not null)
    {
        <meta name="description" content="@preview.Description" />
        <link rel="canonical" href="@preview.CanonicalUrl" />
        <meta property="og:title" content="@preview.Title" />
        <meta property="og:description" content="@preview.Description" />
        <meta property="og:url" content="@preview.CanonicalUrl" />
        <meta property="og:type" content="website" />
        <meta property="og:image" content="@preview.ImageUrl" />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1024" />
        <meta property="og:image:height" content="1024" />
        <meta property="og:image:alt" content="QuillSign" />
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content="@preview.Title" />
        <meta name="twitter:description" content="@preview.Description" />
        <meta name="twitter:image" content="@preview.ImageUrl" />
    }
    <link rel="icon" href="~/logo.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/site.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <main>
        <header><a href="/" class="wordmark"><img src="~/logo-mark.svg" alt="" width="42" height="46" /><span>QuillSign</span></a></header>
        @RenderBody()
        <footer>
            <p>Designed &amp; built by <a href="https://www.hmeyer.com">Henrique Meyer</a> · <a href="https://github.com/henrique-meyer/quillsign">Source on GitHub</a></p>
            @if(Context.RequestServices.GetService<QuillSign.Lifecycle.RecordLifecycleOptions>()?.Mode=="Production") {
                <p>Software provided as-is. Retention and access follow this operator's disclosed policies. Operators are responsible for checking suitability for their use case and jurisdiction.</p>
            } else {
                <p>Demo instance · Data will be purged periodically. Software provided as-is. Operators are responsible for checking suitability for their use case and jurisdiction.</p>
            }
        </footer>
        <partial name="_Analytics" />
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
