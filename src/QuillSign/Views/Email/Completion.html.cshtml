@model QuillSign.Email.CompletionEmailModel
@{
    Layout = "/Views/Email/_Layout.cshtml";
    ViewData["Title"] = "Your completed records";
    ViewData["Preheader"] = "Your completed document and certificate are ready to save.";
}
<h2 style="margin:0 0 16px;color:#0c2340;font-size:20px;line-height:1.4">@Model.Title</h2>
<p style="margin:0 0 16px">The request completed at @Model.CompletedAt.ToString("u") (UTC).</p>
@if(Model.LinkOnly) {<p style="margin:0 0 20px;padding:16px;background-color:#fff5ee;border-left:3px solid #b85c22;border-radius:4px"><strong>Attachment-size warning:</strong> the PDFs are not attached because this packet exceeds the configured email attachment limit. Use your private link to save both files.</p>}
else {<p style="margin:0 0 16px">Attached: the fully executed PDF, including every signer's saved entries and the certificate, plus the standalone certificate of completion. Save both files for your records.</p>}
@await Html.PartialAsync("/Views/Email/_Action.cshtml", new QuillSign.Email.EmailActionModel(Model.Link, "Open your private completed records"))
<p style="margin:0 0 16px">Use your private link for backup downloads. Continue to prepare this link, then select Open records to use it once. Access is readonly and does not restore signing or edits. Do not forward this private link.</p>
<p style="margin:0 0 16px">The link expires at <strong>@Model.LinkExpiresAt.ToString("u") (UTC)</strong>. Saved copies do not depend on this link.</p>
@if(Model.RetainedUntil is { } until) {<p style="margin:0 0 16px;padding:16px;background-color:#f3f5f8;border-radius:6px">Server retention ends at <strong>@until.ToString("u") (UTC)</strong>. Save your copies before then.</p>}
@if(Model.IsDemo) {<p style="margin:0 0 8px;color:#566579;font-size:14px">Demo instance. No uptime or retention guarantees. Not for legally significant documents.</p>}
