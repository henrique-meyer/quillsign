@model QuillSign.Email.VoidEmailModel
@{
    Layout = "/Views/Email/_Layout.cshtml";
    ViewData["Title"] = "Signing request voided";
    ViewData["Preheader"] = "The sender closed this QuillSign signing request.";
}
<h2 style="margin:0 0 16px;color:#0c2340;font-size:20px;line-height:1.4">@Model.Title</h2>
<p style="margin:0 0 16px">The sender voided this request at @Model.VoidedAt.ToString("u") (UTC).</p>
<p style="margin:0 0 16px">Further signing has stopped. Records of earlier actions are retained; this notice does not change those actions or provide access to the document.</p>
@if(Model.Reason is { } reason) {
    <h3 style="margin:24px 0 8px;color:#566579;font-size:14px">Sender's reason</h3>
    <p style="margin:0 0 20px;padding:20px;background-color:#f8fafc;border-left:3px solid #dce2ea;border-radius:4px;white-space:pre-wrap">@reason</p>
}
@if(Model.IsDemo) {<p style="margin:0 0 8px;color:#566579;font-size:14px">Demo instance. No uptime or retention guarantees. Not for legally significant documents.</p>}
