@model QuillSign.Email.SignerInviteModel
@{
    Layout = "/Views/Email/_Layout.cshtml";
    ViewData["Title"] = Model.Heading ?? "Review your signing request";
    ViewData["Preheader"] = "A document is ready for your review in QuillSign.";
}
@if(Model.Notice is not null) {<p style="margin:0 0 20px;padding:16px;background-color:#f3f5f8;border-left:3px solid #f26b5e;border-radius:4px">@Model.Notice</p>}
<p style="margin:0 0 16px">@Model.SignerName @if (!string.IsNullOrWhiteSpace(Model.Role)) {<text>(@Model.Role)</text>},</p>
<p style="margin:0 0 16px">@Model.Sender has sent you a signing request for <strong>@Model.Title</strong>.</p>
@if (!string.IsNullOrWhiteSpace(Model.Message)) {
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:20px 0"><tr><td bgcolor="#f8fafc" style="padding:20px;background-color:#f8fafc;border-left:3px solid #dce2ea;border-radius:4px">
        <p style="margin:0 0 8px;color:#566579;font-size:12px;font-weight:700">Message from the sender:</p>
        <p style="margin:0">@foreach (var line in Model.Message.Replace("\r\n","\n").Replace('\r','\n').Split('\n')) { @line<br /> }</p>
    </td></tr></table>
}
<p style="margin:0 0 16px">Open the request to review the electronic-record disclosure and PDF.</p>
@await Html.PartialAsync("/Views/Email/_Action.cshtml", new QuillSign.Email.EmailActionModel(Model.Link, "Open the request"))
<p style="margin:0 0 16px">Opening this request does not record consent or a signature. You may decline before consenting.</p>
<p style="margin:0 0 16px">This single-use link expires at <strong>@Model.ExpiresAt.ToString("u") (UTC)</strong>. Do not forward it.</p>
<p style="margin:0 0 8px;color:#566579;font-size:14px">Contact the sender if you did not expect this request or need a different arrangement.</p>
