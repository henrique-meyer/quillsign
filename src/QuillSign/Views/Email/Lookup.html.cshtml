@model QuillSign.Email.LookupEmailModel
@{
    Layout = "/Views/Email/_Layout.cshtml";
    ViewData["Title"] = "Your private document lookup link";
    ViewData["Preheader"] = "Access your retained completed documents in QuillSign.";
}
<p style="margin:0 0 16px">Your private link is ready. Open your list to find completed documents still retained by this instance.</p>
@await Html.PartialAsync("/Views/Email/_Action.cshtml", new QuillSign.Email.EmailActionModel(Model.Link, "Open your completed-document list", IncludeFallback: false))
<p style="margin:0 0 16px">Continue to prepare the link, then choose Open my documents to use it once. Do not forward this private link.</p>
<p style="margin:0 0 16px">The link expires at <strong>@Model.ExpiresAt.ToString("u") (UTC)</strong>.</p>
<p style="margin:0 0 16px">If the link does not open, visit <a href="@Model.Entry.AbsoluteUri" rel="noreferrer" style="color:#164c7e;text-decoration:underline">access entry</a>, enter the following code, then confirm:</p>
<p style="margin:0 0 20px;padding:16px;background-color:#f3f5f8;border:1px solid #dce2ea;border-radius:6px;overflow-wrap:anywhere;word-break:break-all"><code style="font-family:Consolas,monospace;font-size:13px">@Model.Code</code></p>
<p style="margin:0 0 16px">Only completed documents still retained by this instance can appear. Open a document to save its executed PDF and completion certificate. Lookup does not restore editing or signing, extend retention or guarantee ongoing availability.</p>
<p style="margin:0 0 16px;color:#566579;font-size:14px">If you did not request this email, you can ignore it.</p>
<p style="margin:0 0 8px;color:#566579;font-size:14px">Demo instance. No uptime or retention guarantees. Not for legally significant documents.</p>
