@model QuillSign.Work.DeclinePayload
@{ Layout = null; }
<!doctype html>
<html lang="en"><head><meta charset="utf-8"><title>Signing request declined</title></head>
<body><p>QuillSign</p><h1>Signing request declined</h1>
<p>The signing request for @Model.Title was declined by @Model.SignerName (@Model.SignerEmail).</p>
<p>Reason: @(Model.Reason ?? "No reason provided.")</p>
<p>This envelope is closed. Contact the signer to discuss another arrangement.</p>
</body></html>
