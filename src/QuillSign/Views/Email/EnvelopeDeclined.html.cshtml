@model QuillSign.Work.DeclinePayload
@{
    Layout = "/Views/Email/_Layout.cshtml";
    ViewData["Title"] = "Signing request declined";
    ViewData["Preheader"] = "A signer declined your QuillSign request.";
}
<p style="margin:0 0 16px">The signing request for <strong>@Model.Title</strong> was declined by @Model.SignerName (@Model.SignerEmail).</p>
<p style="margin:0 0 20px;padding:20px;background-color:#f8fafc;border-left:3px solid #dce2ea;border-radius:4px;white-space:pre-wrap"><strong>Reason:</strong> @(Model.Reason ?? "No reason provided.")</p>
<p style="margin:0 0 8px">This envelope is closed. Contact the signer to discuss another arrangement.</p>
