@model QuillSign.Email.SignerInviteModel
@{ Layout = null; }
QuillSign

@if(Model.Heading is not null) {<text>@Html.Raw(Model.Heading)
</text>}
@if(Model.Notice is not null) {<text>@Html.Raw(Model.Notice)
</text>}

@Html.Raw(Model.SignerName)@if (!string.IsNullOrWhiteSpace(Model.Role)) {<text> (@Html.Raw(Model.Role))</text>},

@Html.Raw(Model.Sender) has sent you a signing request for @Html.Raw(Model.Title).
@if (!string.IsNullOrWhiteSpace(Model.Message)) {<text>
Message from the sender:
@Html.Raw(Model.Message)
</text>}

Open the request to review the electronic-record disclosure and PDF:
@Html.Raw(Model.Link.AbsoluteUri)

Opening this request does not record consent or a signature. You may decline before consenting.
This single-use link expires at @Model.ExpiresAt.ToString("u") (UTC). Do not forward it.
Contact the sender if you did not expect this request or need a different arrangement.
