@model QuillSign.Email.EmailActionModel
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:24px 0"><tr>
    <td align="center" bgcolor="#0c2340" style="background-color:#0c2340;border-radius:8px;mso-padding-alt:14px 24px">
        <a href="@Model.Link.AbsoluteUri" rel="noreferrer" style="display:inline-block;padding:14px 24px;border:1px solid #0c2340;border-radius:8px;color:#ffffff;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:700;line-height:1.4;text-align:center;text-decoration:none;mso-padding-alt:0">@Model.Label</a>
    </td>
</tr></table>
@if (Model.IncludeFallback) {
<p style="margin:0 0 20px;color:#566579;font-size:12px;line-height:1.6">If the button does not work, copy and paste this link into your browser:<br>
    <a href="@Model.Link.AbsoluteUri" rel="noreferrer" style="color:#164c7e;text-decoration:underline;overflow-wrap:anywhere;word-break:break-all">@Model.Link.AbsoluteUri</a>
</p>
}
